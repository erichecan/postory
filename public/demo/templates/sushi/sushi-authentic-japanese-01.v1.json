{
  "schemaVersion": 1,
  "id": "sushi-authentic-japanese-01",
  "version": "1.0.0",
  "industryId": "sushi",
  "categoryId": "signature",
  "family": "sushi-editorial",
  "variant": "authentic",
  "coordinateSystem": {
    "origin": "top-left",
    "units": "normalized fractions of each ratio artboard"
  },
  "assets": {
    "heroSample": "/demo/photos/sushi-salmon-nigiri.png",
    "decorations": "authored as CSS/SVG layers in SushiEditorialFamily"
  },
  "slots": [
    {
      "id": "hero",
      "type": "image",
      "required": true
    },
    {
      "id": "headline",
      "type": "text",
      "required": true,
      "fieldId": "title",
      "maxLength": 32
    },
    {
      "id": "tagline",
      "type": "text",
      "required": false,
      "fieldId": "shortCopy",
      "maxLength": 72
    }
  ],
  "editRules": {
    "hero": {
      "required": true,
      "replaceable": true,
      "fit": "cover",
      "focalPoint": "user-adjustable-per-ratio",
      "zoomRange": [
        1,
        2.5
      ]
    },
    "headline": {
      "editable": true,
      "maxLength": 32,
      "overflow": "fit-and-report"
    },
    "tagline": {
      "editable": true,
      "optional": true,
      "maxLength": 72,
      "overflow": "fit-and-report"
    },
    "watermark": {
      "policy": "shared-demo-watermark",
      "safeAreaPerRatio": true
    }
  },
  "layersBackToFront": [
    "hero",
    "gradient",
    "panel",
    "decorations",
    "eyebrow",
    "headline",
    "tagline",
    "watermark"
