{
  "schemaVersion": 1,
  "id": "sushi-signature-editorial-01",
  "version": "1.0.0",
  "industryId": "sushi",
  "categoryId": "signature",
  "family": "full-bleed-editorial",
  "description": "Premium editorial sushi poster with replaceable hero photography and editable copy.",
  "coordinateSystem": {
    "origin": "top-left",
    "units": "normalized",
    "rect": "x, y, width, height are fractions of the output canvas; each value is in [0, 1].",
    "fontSize": "cqw means a percentage of the logical canvas width, matching CSS container query units.",
    "layerOrder": "ascending zIndex is back-to-front."
  },
  "assets": {
    "samplePhoto": "/demo/templates/sushi/assets/hero-sushi-sample.png",
    "ornamentTop": "/demo/templates/sushi/assets/botanical-top.svg",
    "ornamentBottom": "/demo/templates/sushi/assets/botanical-bottom.svg",
    "accentBrush": "/demo/templates/sushi/assets/accent-brush.png"
  },
  "slots": {
    "hero": {
      "type": "image",
      "required": true,
      "defaultAsset": "samplePhoto",
      "fit": "cover",
      "crop": {
        "method": "cover",
        "focalPointRange": { "x": [0, 1], "y": [0, 1] },
        "defaultFocalPointByRatio": {
          "square": { "x": 0.55, "y": 0.58 },
          "portrait-4x5": { "x": 0.55, "y": 0.6 },
          "story-9x16": { "x": 0.55, "y": 0.55 }
        },
        "zoom": { "default": 1, "min": 1, "max": 3, "step": 0.05 },
        "editable": ["replace", "focalPoint", "zoom"],
        "preserveOriginal": true
      }
    },
    "headline": {
      "type": "text",
      "fieldId": "title",
      "required": true,
      "defaultValue": "Fresh\nSushi",
      "maxLength": 32,
      "maxLines": 2,
      "lineBreaks": "preserve-explicit-then-fit",
      "editable": ["text"],
      "overflow": { "fitFontSize": true, "minFontSizeCqw": 6.5, "clip": false, "showWarning": true }
    },
    "tagline": {
      "type": "text",
      "fieldId": "shortCopy",
      "required": false,
      "defaultValue": "SIMPLE INGREDIENTS\nEXTRAORDINARY TASTE",
      "maxLength": 72,
      "maxLines": 3,
      "lineBreaks": "preserve-explicit-then-fit",
      "transform": "uppercase",
      "editable": ["text"],
      "emptyBehavior": "hide-layer",
      "overflow": { "fitFontSize": true, "minFontSizeCqw": 2.2, "clip": false, "showWarning": true }
    },
    "brandMark": {
      "type": "brand-mark",
      "required": false,
      "defaultMode": "demo-watermark",
      "modes": ["demo-watermark", "customer-logo", "hidden"],
      "editable": ["customerLogoAsset", "mode"],
      "fit": "contain",
      "preserveAspectRatio": true,
      "systemControlled": true,
      "note": "The demo watermark and customer logo use the same reserved slot; never show both at once."
    }
  },
  "layouts": {
    "square": {
      "width": 1080,
      "height": 1080,
      "elements": [
        { "id": "hero", "type": "image", "zIndex": 0, "rect": { "x": 0, "y": 0, "width": 1, "height": 1 }, "slot": "hero", "fit": "cover" },
        { "id": "legibility-gradient", "type": "gradient", "zIndex": 10, "rect": { "x": 0, "y": 0, "width": 1, "height": 1 }, "value": "linear-gradient(105deg, rgba(8,7,6,.62) 0%, rgba(8,7,6,.3) 52%, transparent 78%)", "editable": false },
        { "id": "ornament-top", "type": "image", "zIndex": 20, "rect": { "x": 0.5, "y": 0.43, "width": 0.14, "height": 0.14 }, "asset": "ornamentTop", "fit": "contain", "editable": false },
        { "id": "ornament-bottom", "type": "image", "zIndex": 21, "rect": { "x": 0.05, "y": 0.76, "width": 0.17, "height": 0.16 }, "asset": "ornamentBottom", "fit": "contain", "editable": false },
        { "id": "accent-brush", "type": "image", "zIndex": 22, "rect": { "x": 0.07, "y": 0.68, "width": 0.27, "height": 0.045 }, "asset": "accentBrush", "fit": "contain", "editable": false },
        { "id": "headline", "type": "text", "zIndex": 30, "rect": { "x": 0.055, "y": 0.2, "width": 0.67, "height": 0.27 }, "slot": "headline", "font": { "family": "Georgia, 'Times New Roman', serif", "weight": 500, "sizeCqw": 10, "lineHeight": 0.96, "letterSpacingEm": -0.035, "color": "#FFFFFF", "textShadow": "0 1px 2px rgba(0,0,0,.18)" }, "fit": "shrink-to-fit", "align": "left", "verticalAlign": "top" },
        { "id": "tagline", "type": "text", "zIndex": 31, "rect": { "x": 0.058, "y": 0.54, "width": 0.72, "height": 0.13 }, "slot": "tagline", "font": { "family": "Arial, 'Noto Sans', sans-serif", "weight": 500, "sizeCqw": 3.2, "lineHeight": 1.35, "letterSpacingEm": 0.075, "color": "#FFFFFF", "textShadow": "0 1px 2px rgba(0,0,0,.18)" }, "fit": "shrink-to-fit", "align": "left", "verticalAlign": "top" },
        { "id": "brand-mark", "type": "brand-mark", "zIndex": 40, "rect": { "x": 0.68, "y": 0.86, "width": 0.27, "height": 0.1 }, "slot": "brandMark", "fit": "contain", "editable": "slot-policy" }
      ],
      "photoFocalPoint": { "x": 0.55, "y": 0.58 },
      "watermarkSafeArea": { "x": 0.68, "y": 0.86, "width": 0.27, "height": 0.1 }
    },
    "portrait-4x5": {
      "width": 1080,
      "height": 1350,
      "elements": [
        { "id": "hero", "type": "image", "zIndex": 0, "rect": { "x": 0, "y": 0, "width": 1, "height": 1 }, "slot": "hero", "fit": "cover" },
        { "id": "legibility-gradient", "type": "gradient", "zIndex": 10, "rect": { "x": 0, "y": 0, "width": 1, "height": 1 }, "value": "linear-gradient(105deg, rgba(8,7,6,.62) 0%, rgba(8,7,6,.3) 52%, transparent 78%)", "editable": false },
        { "id": "ornament-top", "type": "image", "zIndex": 20, "rect": { "x": 0.5, "y": 0.33, "width": 0.13, "height": 0.12 }, "asset": "ornamentTop", "fit": "contain", "editable": false },
        { "id": "ornament-bottom", "type": "image", "zIndex": 21, "rect": { "x": 0.06, "y": 0.72, "width": 0.15, "height": 0.12 }, "asset": "ornamentBottom", "fit": "contain", "editable": false },
        { "id": "accent-brush", "type": "image", "zIndex": 22, "rect": { "x": 0.075, "y": 0.555, "width": 0.25, "height": 0.04 }, "asset": "accentBrush", "fit": "contain", "editable": false },
        { "id": "headline", "type": "text", "zIndex": 30, "rect": { "x": 0.055, "y": 0.19, "width": 0.66, "height": 0.22 }, "slot": "headline", "font": { "family": "Georgia, 'Times New Roman', serif", "weight": 500, "sizeCqw": 10.6, "lineHeight": 0.94, "letterSpacingEm": -0.035, "color": "#FFFFFF", "textShadow": "0 1px 2px rgba(0,0,0,.18)" }, "fit": "shrink-to-fit", "align": "left", "verticalAlign": "top" },
        { "id": "tagline", "type": "text", "zIndex": 31, "rect": { "x": 0.058, "y": 0.43, "width": 0.69, "height": 0.1 }, "slot": "tagline", "font": { "family": "Arial, 'Noto Sans', sans-serif", "weight": 500, "sizeCqw": 3.25, "lineHeight": 1.35, "letterSpacingEm": 0.075, "color": "#FFFFFF", "textShadow": "0 1px 2px rgba(0,0,0,.18)" }, "fit": "shrink-to-fit", "align": "left", "verticalAlign": "top" },
        { "id": "brand-mark", "type": "brand-mark", "zIndex": 40, "rect": { "x": 0.69, "y": 0.87, "width": 0.27, "height": 0.09 }, "slot": "brandMark", "fit": "contain", "editable": "slot-policy" }
      ],
      "photoFocalPoint": { "x": 0.55, "y": 0.6 },
      "watermarkSafeArea": { "x": 0.69, "y": 0.87, "width": 0.27, "height": 0.09 }
    },
    "story-9x16": {
      "width": 1080,
      "height": 1920,
      "elements": [
        { "id": "hero", "type": "image", "zIndex": 0, "rect": { "x": 0, "y": 0, "width": 1, "height": 1 }, "slot": "hero", "fit": "cover" },
        { "id": "legibility-gradient", "type": "gradient", "zIndex": 10, "rect": { "x": 0, "y": 0, "width": 1, "height": 1 }, "value": "linear-gradient(180deg, rgba(8,7,6,.66) 0%, rgba(8,7,6,.34) 28%, transparent 49%)", "editable": false },
        { "id": "ornament-top", "type": "image", "zIndex": 20, "rect": { "x": 0.6, "y": 0.3, "width": 0.18, "height": 0.09 }, "asset": "ornamentTop", "fit": "contain", "editable": false },
        { "id": "ornament-bottom", "type": "image", "zIndex": 21, "rect": { "x": 0.06, "y": 0.75, "width": 0.19, "height": 0.1 }, "asset": "ornamentBottom", "fit": "contain", "editable": false },
        { "id": "accent-brush", "type": "image", "zIndex": 22, "rect": { "x": 0.09, "y": 0.495, "width": 0.28, "height": 0.035 }, "asset": "accentBrush", "fit": "contain", "editable": false },
        { "id": "headline", "type": "text", "zIndex": 30, "rect": { "x": 0.07, "y": 0.18, "width": 0.8, "height": 0.17 }, "slot": "headline", "font": { "family": "Georgia, 'Times New Roman', serif", "weight": 500, "sizeCqw": 10.8, "lineHeight": 0.96, "letterSpacingEm": -0.035, "color": "#FFFFFF", "textShadow": "0 1px 2px rgba(0,0,0,.18)" }, "fit": "shrink-to-fit", "align": "left", "verticalAlign": "top" },
        { "id": "tagline", "type": "text", "zIndex": 31, "rect": { "x": 0.075, "y": 0.37, "width": 0.78, "height": 0.1 }, "slot": "tagline", "font": { "family": "Arial, 'Noto Sans', sans-serif", "weight": 500, "sizeCqw": 3.4, "lineHeight": 1.35, "letterSpacingEm": 0.075, "color": "#FFFFFF", "textShadow": "0 1px 2px rgba(0,0,0,.18)" }, "fit": "shrink-to-fit", "align": "left", "verticalAlign": "top" },
        { "id": "brand-mark", "type": "brand-mark", "zIndex": 40, "rect": { "x": 0.68, "y": 0.72, "width": 0.27, "height": 0.08 }, "slot": "brandMark", "fit": "contain", "editable": "slot-policy" }
      ],
      "photoFocalPoint": { "x": 0.55, "y": 0.55 },
      "watermarkSafeArea": { "x": 0.68, "y": 0.72, "width": 0.27, "height": 0.08 },
      "safeArea": { "top": 0.13, "bottom": 0.16 }
    }
  },
  "selectionBadge": "outside-renderer",
  "editingPolicy": {
    "userEditableElements": ["hero", "headline", "tagline", "brandMark"],
    "lockedElements": ["legibility-gradient", "ornament-top", "ornament-bottom", "accent-brush"],
    "allowMove": false,
    "allowResize": false,
    "allowDeleteRequiredSlots": false,
    "neverBakeTextIntoPhoto": true,
    "neverRenderTemplateSelectionBadgeInArtwork": true
  }
}
