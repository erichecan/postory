    {
      "id": "tagline",
      "type": "text",
      "required": false,
      "fieldId": "shortCopy",
      "maxLength": 72
    }
  ],
  "editRules": {
    "hero": {
      "required": true,
      "replaceable": true,
      "fit": "cover",
      "focalPoint": "user-adjustable-per-ratio",
      "zoomRange": [
        1,
        2.5
      ]
    },
    "headline": {
      "editable": true,
      "maxLength": 32,
      "overflow": "fit-and-report"
    },
    "tagline": {
      "editable": true,
      "optional": true,
      "maxLength": 72,
      "overflow": "fit-and-report"
    },
    "watermark": {
      "policy": "shared-demo-watermark",
      "safeAreaPerRatio": true
    }
  },
  "layersBackToFront": [
    "hero",
    "gradient",
    "panel",
