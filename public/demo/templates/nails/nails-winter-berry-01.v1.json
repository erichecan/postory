{
  "schemaVersion": 1,
  "id": "nails-winter-berry-01",
  "version": "1.0.0",
  "industryId": "nails",
  "categoryId": "works",
  "family": "full-bleed-editorial",
  "coordinateSystem": {
    "origin": "top-left",
    "units": "normalized fractions of each ratio artboard"
  },
  "assets": {
    "heroSample": "/demo/templates/nails/assets/hero-winter-berry-sample.webp",
    "ornamentTop": "/demo/templates/nails/assets/winter-berry-upper.svg",
    "ornamentBottom": "/demo/templates/nails/assets/winter-berry-lower.svg",
    "accentBrush": "/demo/templates/nails/assets/winter-berry-accent.svg"
  },
  "slots": [
    {
      "id": "hero",
      "type": "image",
      "required": true,
      "fit": "cover",
      "defaultFocalPoint": {
        "x": 0.69,
        "y": 0.62
      }
    },
    {
      "id": "headline",
      "type": "text",
      "fieldId": "title",
      "required": true,
      "maxLength": 30,
      "maxLines": 2,
      "defaultValue": "冬日莓红\n节日新款",
      "transform": "none"
    },
    {
      "id": "tagline",
      "type": "text",
      "fieldId": "shortCopy",
      "required": false,
      "maxLength": 200,
      "maxLines": 3,
      "defaultValue": "温暖一整个冬天",
      "transform": "none"
    }
  ],
  "editRules": {
    "hero": {
      "required": true,
      "replaceable": true,
      "fit": "cover",
      "focalPoint": "user-adjustable-per-ratio",
      "zoomRange": [
        1,
        2.5
      ]
    },
    "headline": {
      "editable": true,
      "maxLength": 30,
      "maxLines": 2,
      "overflow": "fit-and-report"
    },
    "tagline": {
      "editable": true,
      "optional": true,
      "maxLength": 200,
      "maxLines": 3,
      "overflow": "fit-and-report"
    },
    "decorations": {
      "editable": false
    },
    "watermark": {
      "policy": "shared-demo-watermark",
      "safeAreaPerRatio": true
    }
  },
  "layersBackToFront": [
    "hero",
    "gradient",
    "headline",
