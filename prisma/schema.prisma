generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum AccountSource {
  SELF_SIGNUP
  OFFLINE
}

enum DesignStatus {
  DRAFT
  SCHEDULED
}

enum Currency {
  EUR
  CAD
}

enum PlanStatus {
  DRAFT
  PENDING_PAYMENT
  ACTIVE
  PAST_DUE
  CANCELED
}

enum PlanBilling {
  STRIPE
  OFFLINE
}

enum GrantSource {
  SIGNUP_GIFT
  MONTHLY
  TOPUP
  ADMIN
  REFUND_RETURN
}

enum GrantScope {
  ANY
  TEMPLATE_ONLY
}

enum GrantUnit {
  CREDIT
  VIDEO
}

enum TxnKind {
  GRANT
  DEBIT
  REFUND
  EXPIRE
  ADJUST
}

enum ChargeKind {
  TEMPLATE_EXPORT
  AI_STANDARD
  AI_HD
}

enum GenerationMode {
  PHOTO_ENHANCE
  TEXT_TO_IMAGE
}

enum GenerationStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum Industry {
  FOOD_TAKEAWAY
  BEAUTY_HAIR
  FITNESS
  PHONE_REPAIR
  OTHER
}

enum Country {
  IE
  CA
}

enum EventRegion {
  IE
  CA
  BOTH
  CHINESE_COMMUNITY
}

enum PromoMechanism {
  OFF_PEAK_DISCOUNT
  LOYALTY_POINTS
  BOUNCE_BACK_COUPON
  REFERRAL
  BUNDLE_PREPAID
  LIMITED_TIME
  BIRTHDAY_PERK
  OWN_CHANNEL_DISCOUNT
}

enum CalendarSlotStatus {
  SUGGESTED
  CONFIRMED
  DESIGN_CREATED
  PUBLISHED
}

enum ApprovalChannel {
  WHATSAPP
}

enum ApprovalStatus {
  PENDING
  APPROVED
  AUTO_APPROVED
  REJECTED
}

enum OutreachType {
  WELCOME
  THANK_YOU
  BIRTHDAY
  RENEWAL_REMINDER
  WINBACK_1
  WINBACK_2
  WINBACK_3
}

enum OutreachChannel {
  EMAIL
  SMS
}

enum OutreachStatus {
  SCHEDULED
  SENT
  SKIPPED
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
}

enum PublishStatus {
  PENDING
  SUCCESS
  PARTIAL
  FAILED
}

model User {
  id                    String               @id @default(cuid())
  phone                 String?              @unique @db.VarChar(20)
  email                 String?              @unique @db.VarChar(254)
  emailVerifiedAt       DateTime?
  stripeCustomerId      String?              @unique
  passwordHash          String
  sessionVersion        Int                  @default(0)
  loginFailures         Int                  @default(0)
  loginLockedUntil      DateTime?
  name                  String               @db.VarChar(64)
  role                  Role                 @default(USER)
  source                AccountSource        @default(SELF_SIGNUP)
  disabled              Boolean              @default(false)
  createdAt             DateTime             @default(now())
  ayrshareProfileKeyEnc String?
  ayrshareRefId         String?
  profile               BrandProfile?
  designs               Design[]
  plan                  CustomerPlan?
  grants                CreditGrant[]
  txns                  CreditTxn[]
  generations           Generation[]
  socialAccounts        SocialAccount[]
  calendarSlots         CalendarSlot[]
  approvalRequests      ApprovalRequest[]
  outreachAutomations   OutreachAutomation[]
  endCustomers          EndCustomer[]
  studio                Studio?
}

// Phase 1: one personally owned studio per account. User is the shared profile.
model Studio {
  id          String       @id @default(cuid())
  ownerId     String       @unique
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String       @db.VarChar(64)
  timeZone    String       @db.VarChar(64)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  mediaAssets MediaAsset[]
}

// Owned by a studio, independent of any single Post (not modeled yet). Reusable across future notes.
model MediaAsset {
  id        String   @id @default(cuid())
  studioId  String
  studio    Studio   @relation(fields: [studioId], references: [id], onDelete: Cascade)
  key       String   @unique
  mimeType  String   @db.VarChar(32)
  byteSize  Int
  width     Int
  height    Int
  createdAt DateTime @default(now())

  @@index([studioId, createdAt])
}

model SocialAccount {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform    String    @db.VarChar(32)
  handle      String?   @db.VarChar(128)
  connectedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, platform])
}

model EmailToken {
  id        String    @id @default(cuid())
  email     String    @db.VarChar(254)
  purpose   String    @db.VarChar(16)
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, purpose])
}

model MembershipTier {
  id                    String         @id @default(cuid())
  slug                  String         @unique @db.VarChar(32)
  nameZh                String         @db.VarChar(64)
  nameEn                String         @db.VarChar(64)
  taglineZh             String         @db.VarChar(64)
  taglineEn             String         @db.VarChar(64)
  benefitsZh            String[]
  benefitsEn            String[]
  features              Json
  defaultMonthlyCredits Int            @default(60)
  defaultMonthlyVideos  Int            @default(4)
  referenceFee          Int            @default(9900)
  recommended           Boolean        @default(false)
  sortOrder             Int            @default(0)
  visible               Boolean        @default(true)
  plans                 CustomerPlan[]
}

model CustomerPlan {
  userId               String         @id
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tierId               String
  tier                 MembershipTier @relation(fields: [tierId], references: [id])
  currency             Currency
  billing              PlanBilling    @default(STRIPE)
  baseFee              Int
  extraPlatforms       String[]
  extraPlatformFee     Int
  allInclusiveFee      Int?
  monthlyCredits       Int
  monthlyVideos        Int
  topupUnitPrice       Int            @default(100)
  status               PlanStatus     @default(DRAFT)
  stripeSubscriptionId String?        @unique
  currentPeriodEnd     DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
}

model CreditGrant {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit      GrantUnit   @default(CREDIT)
  source    GrantSource
  scope     GrantScope  @default(ANY)
  amount    Int
  remaining Int
  validFrom DateTime    @default(now())
  expiresAt DateTime?
  refId     String?     @unique
  createdAt DateTime    @default(now())

  @@index([userId, unit, expiresAt])
}

model CreditTxn {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        TxnKind
  charge      ChargeKind?
  source      GrantSource?
  delta       Int
  allocations Json?
  refId       String?
  note        String?      @db.VarChar(255)
  actorId     String?
  createdAt   DateTime     @default(now())

  @@unique([userId, kind, refId])
  @@index([userId, createdAt])
}

model Generation {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId    String?
  mode        GenerationMode
  quality     String           @db.VarChar(8)
  size        String           @db.VarChar(16)
  userPrompt  String           @db.Text
  finalPrompt String?          @db.Text
  inputUrl    String?
  outputUrl   String?
  credits     Int
  costMicros  Int?
  status      GenerationStatus @default(PENDING)
  error       String?          @db.VarChar(255)
  startedAt   DateTime?
  createdAt   DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

model BrandProfile {
  userId   String  @id
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopName String? @db.VarChar(64)
  wechat   String? @db.VarChar(64)
  phone    String? @db.VarChar(20)
  address  String? @db.VarChar(255)
  logoUrl  String?
  slogan   String? @db.VarChar(255)
  activity String? @db.Text

  industry            Industry?
  country             Country?
  whatsappNumber      String?   @unique @db.VarChar(20)
  marketingEmailOptIn Boolean   @default(false)
  marketingSmsOptIn   Boolean   @default(false)
}

model Template {
  id          String   @id
  source      String
  title       String
  description String?  @db.Text
  categories  String[] @default([])
  status      String   @default("published")
  platform    String
  width       Int
  height      Int
  thumbnails  String[]
  pages       Json
  editable    Boolean
  sourceUrl   String
  sortOrder   Int
  designs     Design[]

  @@index([platform, sortOrder])
  @@index([status, sortOrder])
}

model Design {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId       String?
  template         Template?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  title            String         @db.VarChar(128)
  pages            Json
  platforms        String[]
  scheduledAt      DateTime?
  status           DesignStatus   @default(DRAFT)
  chargedAt        DateTime?
  caption          String?        @db.Text
  exportedImageUrl String?
  ayrsharePostId   String?
  publishStatus    PublishStatus?
  publishError     String?        @db.Text
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  calendarSlot     CalendarSlot?

  @@index([userId, updatedAt])
}

model MarketingEvent {
  id         String             @id
  startDate  DateTime           @db.Date
  endDate    DateTime           @db.Date
  nameZh     String             @db.VarChar(64)
  nameEn     String             @db.VarChar(64)
  region     EventRegion
  industries Industry[]
  prepWeeks  Int                @default(0)
  source     String?            @db.VarChar(255)
  createdAt  DateTime           @default(now())
  campaigns  CampaignTemplate[]
  slots      CalendarSlot[]

  @@index([startDate, endDate])
}

model CampaignTemplate {
  id                 String          @id
  industry           Industry
  nameZh             String          @db.VarChar(64)
  nameEn             String          @db.VarChar(64)
  mechanism          PromoMechanism
  suggestedPostCount Int             @default(1)
  eventId            String?
  event              MarketingEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  captionAngle       String          @db.Text
  createdAt          DateTime        @default(now())
  slots              CalendarSlot[]

  @@index([industry])
}

model CalendarSlot {
  id                 String             @id @default(cuid())
  userId             String
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  date               DateTime           @db.Date
  campaignTemplateId String?
  campaignTemplate   CampaignTemplate?  @relation(fields: [campaignTemplateId], references: [id], onDelete: SetNull)
  eventId            String?
  event              MarketingEvent?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  weeklyRhythmTag    String?            @db.VarChar(32)
  status             CalendarSlotStatus @default(SUGGESTED)
  designId           String?            @unique
  design             Design?            @relation(fields: [designId], references: [id], onDelete: SetNull)
  approvalRequests   ApprovalRequest[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([userId, date])
}

model ApprovalRequest {
  id                String          @id @default(cuid())
  calendarSlotId    String
  calendarSlot      CalendarSlot    @relation(fields: [calendarSlotId], references: [id], onDelete: Cascade)
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel           ApprovalChannel @default(WHATSAPP)
  sentAt            DateTime        @default(now())
  status            ApprovalStatus  @default(PENDING)
  respondedAt       DateTime?
  autoApproveAt     DateTime
  providerMessageId String?

  @@index([status, autoApproveAt])
}

model OutreachAutomation {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  endCustomerId String?
  endCustomer   EndCustomer?    @relation(fields: [endCustomerId], references: [id], onDelete: Cascade)
  type          OutreachType
  channel       OutreachChannel
  triggerAt     DateTime
  status        OutreachStatus  @default(SCHEDULED)
  payload       Json?
  createdAt     DateTime        @default(now())

  @@index([status, triggerAt])
}

model EndCustomer {
  id          String               @id @default(cuid())
  userId      String
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String?              @db.VarChar(64)
  email       String?              @db.VarChar(254)
  phone       String?              @db.VarChar(20)
  lastVisitAt DateTime?
  birthday    DateTime?            @db.Date
  source      String?              @db.VarChar(32)
  createdAt   DateTime             @default(now())
  outreach    OutreachAutomation[]

  @@index([userId])
}

model CalendarLead {
  id                  String     @id @default(cuid())
  shopName            String     @db.VarChar(128)
  industry            Industry
  country             Country
  contactEmail        String     @db.VarChar(254)
  contactPhone        String?    @db.VarChar(20)
  generatedPreviewUrl String?
  status              LeadStatus @default(NEW)
  createdAt           DateTime   @default(now())
}
