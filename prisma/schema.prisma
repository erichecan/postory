generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum AccountSource {
  SELF_SIGNUP
  OFFLINE
}

enum DesignStatus {
  DRAFT
  SCHEDULED
}

enum Currency {
  EUR
  CAD
}

enum PlanStatus {
  DRAFT
  PENDING_PAYMENT
  ACTIVE
  PAST_DUE
  CANCELED
}

enum PlanBilling {
  STRIPE
  OFFLINE
}

enum GrantSource {
  SIGNUP_GIFT
  MONTHLY
  TOPUP
  ADMIN
  REFUND_RETURN
}

enum GrantScope {
  ANY
  TEMPLATE_ONLY
}

enum GrantUnit {
  CREDIT
  VIDEO
}

enum TxnKind {
  GRANT
  DEBIT
  REFUND
  EXPIRE
  ADJUST
}

enum ChargeKind {
  TEMPLATE_EXPORT
  AI_STANDARD
  AI_HD
  VIDEO_STANDARD
  VIDEO_OVERAGE
}

enum GenerationMode {
  PHOTO_ENHANCE
  TEXT_TO_IMAGE
  VIDEO
}

enum GenerationStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum DemoTrialGenerationStatus {
  RESERVED
  SUCCEEDED
  FAILED
}

enum Industry {
  FOOD_TAKEAWAY
  BEAUTY_HAIR
  FITNESS
  PHONE_REPAIR
  OTHER
}

enum Country {
  IE
  CA
}

enum EventRegion {
  IE
  CA
  BOTH
  CHINESE_COMMUNITY
}

enum PromoMechanism {
  OFF_PEAK_DISCOUNT
  LOYALTY_POINTS
  BOUNCE_BACK_COUPON
  REFERRAL
  BUNDLE_PREPAID
  LIMITED_TIME
  BIRTHDAY_PERK
  OWN_CHANNEL_DISCOUNT
}

enum CalendarSlotStatus {
  SUGGESTED
  CONFIRMED
  DESIGN_CREATED
  PUBLISHED
}

enum ApprovalChannel {
  WHATSAPP
}

enum ApprovalStatus {
  PENDING
  APPROVED
  AUTO_APPROVED
  REJECTED
}

enum OutreachType {
  WELCOME
  THANK_YOU
  BIRTHDAY
  RENEWAL_REMINDER
  WINBACK_1
  WINBACK_2
  WINBACK_3
}

enum OutreachChannel {
  EMAIL
  SMS
}

enum OutreachStatus {
  SCHEDULED
  SENT
  SKIPPED
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
}

enum PartnerTrialStatus {
  SUBMITTED
  IN_PROGRESS
  DELIVERED
  CONVERTED
}

enum PartnerTrialFeedbackCategory {
  STYLE
  CONTENT_ACCURACY
  REVISION_REQUEST
}

enum PublishStatus {
  PENDING
  SUCCESS
  PARTIAL
  FAILED
}

model User {
  id                    String                @id @default(cuid())
  phone                 String?               @unique @db.VarChar(20)
  email                 String?               @unique @db.VarChar(254)
  emailVerifiedAt       DateTime?
  stripeCustomerId      String?               @unique
  passwordHash          String
  sessionVersion        Int                   @default(0)
  loginFailures         Int                   @default(0)
  loginLockedUntil      DateTime?
  name                  String                @db.VarChar(64)
  role                  Role                  @default(USER)
  source                AccountSource         @default(SELF_SIGNUP)
  disabled              Boolean               @default(false)
  createdAt             DateTime              @default(now())
  ayrshareProfileKeyEnc String?
  ayrshareRefId         String?
  profile               BrandProfile?
  designs               Design[]
  plan                  CustomerPlan?
  grants                CreditGrant[]
  txns                  CreditTxn[]
  generations           Generation[]
  socialAccounts        SocialAccount[]
  calendarSlots         CalendarSlot[]
  approvalRequests      ApprovalRequest[]
  outreachAutomations   OutreachAutomation[]
  endCustomers          EndCustomer[]
  studio                Studio?
  agencyAccessGranted   AgencyAccess[]        @relation("AgencyAccessAsAgency")
  agencyAccessReceived  AgencyAccess[]        @relation("AgencyAccessAsClient")
  partnerTrialRequests  PartnerTrialRequest[]
}

// Phase 1: one personally owned studio per account. User is the shared profile.
model Studio {
  id                     String          @id @default(cuid())
  ownerId                String          @unique
  owner                  User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name                   String          @db.VarChar(64)
  timeZone               String          @db.VarChar(64)
  defaultDurationMinutes Int             @default(60)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  mediaAssets            MediaAsset[]
  businessHours          BusinessHours[]
  closedPeriods          ClosedPeriod[]
  appointments           Appointment[]
  posts                  NailsPost[]
}

// Owned by a studio, independent of any single Post (not modeled yet). Reusable across future notes.
model MediaAsset {
  id        String           @id @default(cuid())
  studioId  String
  studio    Studio           @relation(fields: [studioId], references: [id], onDelete: Cascade)
  key       String           @unique
  mimeType  String           @db.VarChar(32)
  byteSize  Int
  width     Int
  height    Int
  createdAt DateTime         @default(now())
  postMedia NailsPostMedia[]

  @@index([studioId, createdAt])
}

model NailsPost {
  id                String                  @id @default(cuid())
  studioId          String
  studio            Studio                  @relation(fields: [studioId], references: [id], onDelete: Cascade)
  theme             NailsPostTheme          @default(SHOWCASE)
  template          NailsPostTemplate       @default(WORK)
  title             String                  @default("") @db.VarChar(100)
  body              String                  @default("") @db.VarChar(3000)
  tags              String[]                @default([])
  platform          String                  @default("XIAOHONGSHU") @db.VarChar(32)
  status            NailsPostStatus         @default(DRAFT)
  aiGenerationCount Int                     @default(0)
  exportedAt        DateTime?
  publishedAt       DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  media             NailsPostMedia[]
  availability      NailsPostAvailability[]
  exports           NailsPostExport[]

  @@index([studioId, updatedAt])
  @@index([studioId, status, createdAt])
}

model NailsPostMedia {
  postId       String
  post         NailsPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  mediaAssetId String
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  position     Int

  @@id([postId, mediaAssetId])
  @@unique([postId, position])
  @@index([mediaAssetId])
}

model NailsPostAvailability {
  id        String    @id @default(cuid())
  postId    String
  post      NailsPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  startAt   DateTime  @db.Timestamptz(3)
  endAt     DateTime  @db.Timestamptz(3)
  timeZone  String    @db.VarChar(64)
  createdAt DateTime  @default(now())

  @@index([postId, startAt])
}

model NailsPostExport {
  id         String    @id @default(cuid())
  postId     String
  post       NailsPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  storageKey String    @unique
  mimeType   String    @db.VarChar(32)
  createdAt  DateTime  @default(now())

  @@index([postId, createdAt])
}

model BusinessHours {
  id          String   @id @default(cuid())
  studioId    String
  studio      Studio   @relation(fields: [studioId], references: [id], onDelete: Cascade)
  weekday     Int
  isClosed    Boolean  @default(false)
  startMinute Int      @default(540)
  endMinute   Int      @default(1080)
  updatedAt   DateTime @updatedAt

  @@unique([studioId, weekday])
}

model ClosedPeriod {
  id        String   @id @default(cuid())
  studioId  String
  studio    Studio   @relation(fields: [studioId], references: [id], onDelete: Cascade)
  startAt   DateTime @db.Timestamptz(3)
  endAt     DateTime @db.Timestamptz(3)
  reason    String?  @db.VarChar(120)
  createdAt DateTime @default(now())

  @@index([studioId, startAt])
}

enum NailsAppointmentStatus {
  CONFIRMED
  CANCELLED
}

enum NailsPostStatus {
  DRAFT
  EXPORTED
  PUBLISHED
}

enum NailsPostTheme {
  SHOWCASE
  OPEN_SLOTS
  PROMOTION
  DAILY
}

enum NailsPostTemplate {
  WORK
  SLOTS
  PROMOTION
}

model Appointment {
  id         String                 @id @default(cuid())
  studioId   String
  studio     Studio                 @relation(fields: [studioId], references: [id], onDelete: Cascade)
  startAt    DateTime               @db.Timestamptz(3)
  endAt      DateTime               @db.Timestamptz(3)
  clientName String                 @db.VarChar(80)
  note       String?                @db.VarChar(280)
  status     NailsAppointmentStatus @default(CONFIRMED)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  @@index([studioId, startAt])
}

model SocialAccount {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform    String    @db.VarChar(32)
  handle      String?   @db.VarChar(128)
  connectedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, platform])
}

model EmailToken {
  id        String    @id @default(cuid())
  email     String    @db.VarChar(254)
  purpose   String    @db.VarChar(16)
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, purpose])
}

model MembershipTier {
  id                    String         @id @default(cuid())
  slug                  String         @unique @db.VarChar(32)
  nameZh                String         @db.VarChar(64)
  nameEn                String         @db.VarChar(64)
  taglineZh             String         @db.VarChar(64)
  taglineEn             String         @db.VarChar(64)
  benefitsZh            String[]
  benefitsEn            String[]
  features              Json
  defaultMonthlyCredits Int            @default(60)
  defaultMonthlyVideos  Int            @default(4)
  referenceFee          Int            @default(9900)
  recommended           Boolean        @default(false)
  sortOrder             Int            @default(0)
  visible               Boolean        @default(true)
  plans                 CustomerPlan[]
}

model CustomerPlan {
  userId               String         @id
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tierId               String
  tier                 MembershipTier @relation(fields: [tierId], references: [id])
  currency             Currency
  billing              PlanBilling    @default(STRIPE)
  baseFee              Int
  extraPlatforms       String[]
  extraPlatformFee     Int
  allInclusiveFee      Int?
  monthlyCredits       Int
  monthlyVideos        Int
  topupUnitPrice       Int            @default(100)
  status               PlanStatus     @default(DRAFT)
  stripeSubscriptionId String?        @unique
  currentPeriodEnd     DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
}

model CreditGrant {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit      GrantUnit   @default(CREDIT)
  source    GrantSource
  scope     GrantScope  @default(ANY)
  amount    Int
  remaining Int
  validFrom DateTime    @default(now())
  expiresAt DateTime?
  refId     String?     @unique
  createdAt DateTime    @default(now())

  @@index([userId, unit, expiresAt])
}

model CreditTxn {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        TxnKind
  charge      ChargeKind?
  source      GrantSource?
  delta       Int
  allocations Json?
  refId       String?
  note        String?      @db.VarChar(255)
  actorId     String?
  createdAt   DateTime     @default(now())

  @@unique([userId, kind, refId])
  @@index([userId, createdAt])
}

model Generation {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId        String?
  mode            GenerationMode
  quality         String           @db.VarChar(8)
  size            String           @db.VarChar(16)
  userPrompt      String           @db.Text
  finalPrompt     String?          @db.Text
  inputUrl        String?
  outputUrl       String?
  durationSeconds Int?
  credits         Int
  costMicros      Int?
  status          GenerationStatus @default(PENDING)
  error           String?          @db.VarChar(255)
  startedAt       DateTime?
  createdAt       DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// Server-side anonymous demo quota ledger. Browser state is never used as the source of truth.
model DemoTrialGeneration {
  id             String                    @id @default(cuid())
  industry       String                    @db.VarChar(32)
  visitorHash    String                    @db.Char(64)
  ipHash         String                    @db.Char(64)
  phoneHash      String?                   @db.Char(64)
  idempotencyKey String                    @unique @db.Char(64)
  status         DemoTrialGenerationStatus @default(RESERVED)
  quality        String                    @default("medium") @db.VarChar(8)
  costMicros     Int?
  createdAt      DateTime                  @default(now())
  completedAt    DateTime?

  @@index([visitorHash, createdAt])
  @@index([ipHash, createdAt])
  @@index([phoneHash, createdAt])
  @@index([status, createdAt])
}

// Short-lived, single-use operator exception issued after a blocked visitor contacts support.
model DemoTrialOverride {
  id          String    @id @default(cuid())
  tokenHash   String    @unique @db.Char(64)
  reason      String?   @db.VarChar(255)
  createdById String    @db.VarChar(64)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  consumedAt  DateTime?

  @@index([expiresAt, consumedAt])
}

model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

model BrandProfile {
  userId   String  @id
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopName String? @db.VarChar(64)
  wechat   String? @db.VarChar(64)
  phone    String? @db.VarChar(20)
  address  String? @db.VarChar(255)
  logoUrl  String?
  slogan   String? @db.VarChar(255)
  activity String? @db.Text

  industry            Industry?
  country             Country?
  whatsappNumber      String?   @unique @db.VarChar(20)
  marketingEmailOptIn Boolean   @default(false)
  marketingSmsOptIn   Boolean   @default(false)
}

model Template {
  id          String   @id
  source      String
  title       String
  description String?  @db.Text
  categories  String[] @default([])
  status      String   @default("published")
  platform    String
  width       Int
  height      Int
  thumbnails  String[]
  pages       Json
  editable    Boolean
  sourceUrl   String
  sortOrder   Int
  designs     Design[]

  @@index([platform, sortOrder])
  @@index([status, sortOrder])
}

// revisionCount: 2 次免费微调原地累加；第 3 次编辑在应用层强制新建一条 Design 并扣新额度
model Design {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId       String?
  template         Template?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  title            String         @db.VarChar(128)
  pages            Json
  platforms        String[]
  scheduledAt      DateTime?
  status           DesignStatus   @default(DRAFT)
  chargedAt        DateTime?
  caption          String?        @db.Text
  revisionCount    Int            @default(0)
  exportedImageUrl String?
  ayrsharePostId   String?
  publishStatus    PublishStatus?
  publishError     String?        @db.Text
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  calendarSlot     CalendarSlot?

  @@index([userId, updatedAt])
}

model MarketingEvent {
  id         String             @id
  startDate  DateTime           @db.Date
  endDate    DateTime           @db.Date
  nameZh     String             @db.VarChar(64)
  nameEn     String             @db.VarChar(64)
  region     EventRegion
  industries Industry[]
  prepWeeks  Int                @default(0)
  source     String?            @db.VarChar(255)
  createdAt  DateTime           @default(now())
  campaigns  CampaignTemplate[]
  slots      CalendarSlot[]

  @@index([startDate, endDate])
}

model CampaignTemplate {
  id                 String          @id
  industry           Industry
  nameZh             String          @db.VarChar(64)
  nameEn             String          @db.VarChar(64)
  mechanism          PromoMechanism
  suggestedPostCount Int             @default(1)
  eventId            String?
  event              MarketingEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  captionAngle       String          @db.Text
  createdAt          DateTime        @default(now())
  slots              CalendarSlot[]

  @@index([industry])
}

model CalendarSlot {
  id                 String             @id @default(cuid())
  userId             String
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  date               DateTime           @db.Date
  campaignTemplateId String?
  campaignTemplate   CampaignTemplate?  @relation(fields: [campaignTemplateId], references: [id], onDelete: SetNull)
  eventId            String?
  event              MarketingEvent?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  weeklyRhythmTag    String?            @db.VarChar(32)
  status             CalendarSlotStatus @default(SUGGESTED)
  designId           String?            @unique
  design             Design?            @relation(fields: [designId], references: [id], onDelete: SetNull)
  approvalRequests   ApprovalRequest[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([userId, date])
}

model ApprovalRequest {
  id                String          @id @default(cuid())
  calendarSlotId    String
  calendarSlot      CalendarSlot    @relation(fields: [calendarSlotId], references: [id], onDelete: Cascade)
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel           ApprovalChannel @default(WHATSAPP)
  sentAt            DateTime        @default(now())
  status            ApprovalStatus  @default(PENDING)
  respondedAt       DateTime?
  autoApproveAt     DateTime
  providerMessageId String?

  @@index([status, autoApproveAt])
}

model OutreachAutomation {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  endCustomerId String?
  endCustomer   EndCustomer?    @relation(fields: [endCustomerId], references: [id], onDelete: Cascade)
  type          OutreachType
  channel       OutreachChannel
  triggerAt     DateTime
  status        OutreachStatus  @default(SCHEDULED)
  payload       Json?
  createdAt     DateTime        @default(now())

  @@index([status, triggerAt])
}

model EndCustomer {
  id          String               @id @default(cuid())
  userId      String
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String?              @db.VarChar(64)
  email       String?              @db.VarChar(254)
  phone       String?              @db.VarChar(20)
  lastVisitAt DateTime?
  birthday    DateTime?            @db.Date
  source      String?              @db.VarChar(32)
  createdAt   DateTime             @default(now())
  outreach    OutreachAutomation[]

  @@index([userId])
}

model CalendarLead {
  id                  String     @id @default(cuid())
  shopName            String     @db.VarChar(128)
  industry            Industry
  country             Country
  contactEmail        String     @db.VarChar(254)
  contactPhone        String?    @db.VarChar(20)
  generatedPreviewUrl String?
  status              LeadStatus @default(NEW)
  createdAt           DateTime   @default(now())
}

// 代理商对某个客户账号的操作授权。数据归属仍是 clientUser 自己（一个客户一个 User/Studio），
// agencyUser 只是被授权以该客户身份操作，不是另一套租户模型。
model AgencyAccess {
  id           String   @id @default(cuid())
  agencyUserId String
  agencyUser   User     @relation("AgencyAccessAsAgency", fields: [agencyUserId], references: [id], onDelete: Cascade)
  clientUserId String
  clientUser   User     @relation("AgencyAccessAsClient", fields: [clientUserId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([agencyUserId, clientUserId])
  @@index([clientUserId])
}

// 代理商为真实客户提交的免费试做申请。转付费前客户还没有自己的 User 账号，结果挂在这张表上。
model PartnerTrialRequest {
  id                 String                 @id @default(cuid())
  agencyUserId       String?
  agencyUser         User?                  @relation(fields: [agencyUserId], references: [id], onDelete: SetNull)
  agencyName         String                 @db.VarChar(64)
  agencyContact      String                 @db.VarChar(128)
  clientBrandName    String                 @db.VarChar(128)
  industry           Industry
  country            Country
  productOrService   String                 @db.Text
  targetAudience     String?                @db.Text
  highlightNotes     String?                @db.Text
  platforms          String[]
  websiteUrl         String?
  socialHandles      Json?
  languagePreference String                 @default("zh") @db.VarChar(8)
  viewToken          String                 @unique @db.VarChar(64)
  status             PartnerTrialStatus     @default(SUBMITTED)
  convertedUserId    String?                @unique
  createdAt          DateTime               @default(now())
  deliveredAt        DateTime?
  assets             PartnerTrialAsset[]
  planItems          PartnerTrialPlanItem[]
  feedback           PartnerTrialFeedback[]

  @@index([clientBrandName, agencyContact])
  @@index([status, createdAt])
}

// 试做阶段的样片：一张原始图片 + 多平台适配版本，不单独扣额度（同一份内容）
model PartnerTrialAsset {
  id               String              @id @default(cuid())
  trialRequestId   String
  trialRequest     PartnerTrialRequest @relation(fields: [trialRequestId], references: [id], onDelete: Cascade)
  storageKey       String              @unique
  caption          String?             @db.Text
  platformVariants Json
  revisionCount    Int                 @default(0)
  createdAt        DateTime            @default(now())

  @@index([trialRequestId])
}

model PartnerTrialPlanItem {
  id             String              @id @default(cuid())
  trialRequestId String
  trialRequest   PartnerTrialRequest @relation(fields: [trialRequestId], references: [id], onDelete: Cascade)
  date           DateTime            @db.Date
  theme          String              @db.VarChar(128)
  platform       String              @db.VarChar(32)
  note           String?             @db.Text

  @@index([trialRequestId, date])
}

model PartnerTrialFeedback {
  id             String                       @id @default(cuid())
  trialRequestId String
  trialRequest   PartnerTrialRequest          @relation(fields: [trialRequestId], references: [id], onDelete: Cascade)
  category       PartnerTrialFeedbackCategory
  content        String                       @db.Text
  createdAt      DateTime                     @default(now())

  @@index([trialRequestId, createdAt])
}
